{
  // Firebase Realtime Database security rules — AntiGravity Harvesting Report.
  //
  // Deploy: Firebase console → Realtime Database → Rules → paste this file →
  // Publish. (The console editor accepts these // comments.)
  //
  // Role data lives at user_roles/<uid>:
  //   { role: 'admin'|'user', allowedMenus, editableMenus, editableMenusMap,
  //     firstLogin, email, createdAt }
  // editableMenus is an array (rules can't test array membership), so the app
  // also writes editableMenusMap: { ffbBudget:true, maintenance:true, ... }.
  // NOTE: users created before editableMenusMap existed have no map — an admin
  // must re-save their permissions once (User Management → Edit → Save) or
  // their writes will be denied after these rules go live.
  //
  // 'dataManagement' is treated as full data-write permission because its
  // Restore feature rewrites every shared/* section.
  "rules": {
    // everything not matched below is denied by default

    "user_roles": {
      // listing ALL users (emails!) is admin-only; the one exception is the
      // first-user bootstrap, which must check whether user_roles is empty
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || !root.child('user_roles').exists())",

      "$uid": {
        // everyone may read their own record (login role lookup)
        ".read": "auth != null && auth.uid === $uid",

        // writes allowed for:
        //  1. admins (User Management create/edit/delete)
        //  2. the first-ever user bootstrapping their own admin record while
        //     user_roles is still empty (loadUserRole in script.js)
        //  3. a signed-in user creating their own DEFAULT record — role 'user'
        //     and no menu grants — when no record exists yet
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !root.child('user_roles').exists()) || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'user' && !newData.child('allowedMenus').exists() && !newData.child('editableMenus').exists() && !newData.child('editableMenusMap').exists()))",

        // a user may clear their own first-login flag after changing password
        "firstLogin": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === false"
        }
      }
    },

    "shared": {
      ".read": "auth != null",

      // main app state: planting record, gangs, harvesting performance,
      // rainfall, FFB budget — written by saveState()
      "app_state": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('ffbBudget').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('planting').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('gangs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('performance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('rainfall').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Spraying, Manuring and the Maintenance module all sit under the
      // 'maintenance' menu key
      "spraying_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },
      "manuring_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },
      "maintenance_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      "ironhorse_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('ironhorse').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Rate of Wages — payment calc, gated by the 'wages' menu key
      "wages_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Wage Ledger — detailed actuals import, gated by the 'wages' menu key (shared with the calculator)
      "wages_ledger_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Daily Wage Ledger — job card summary import, gated by the 'wages' menu key (shared with the calculator)
      "wages_daily_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Tree Logs Recording — delivery batches + species detail (menu key 'treelogs')
      "tree_logs_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('treelogs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },
      // Tree Logs invoice PDFs (stored as data URLs, kept out of the main record) — 'treelogs'
      "tree_logs_invoice_files": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('treelogs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Weekly Activity record + its photo/map images (stored as data URLs)
      "weekly_activity_data": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('weekly').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },
      "weekly_images": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('weekly').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // Append-only audit trail. Any signed-in user may ADD a new entry, but
      // existing entries are immutable: they cannot be overwritten, and can only
      // be deleted if older than 12 months (the client purge) or by an admin.
      // No '.write' on the audit_log node itself, so the whole log can't be
      // wiped in one set(null) — each child is guarded individually.
      "audit_log": {
        "$entryId": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && data.child('ts').val() < (now - 31536000000)) || root.child('user_roles').child(auth.uid).child('role').val() === 'admin')",
          // a new entry must carry a timestamp and the author's identity
          ".validate": "newData.hasChildren(['ts','user','action']) || !newData.exists()"
        }
      },

      "backup_settings": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
      },

      // ── Additional workspaces (e.g. Tree Planting) ──────────────────────
      // The Oil Palm workspace keeps the legacy shared/<section> paths above.
      // Every OTHER workspace stores the same sections under
      // shared/ws/<workspaceId>/<section>. Logins & permissions are shared
      // across all workspaces, so the per-section write rules are identical
      // to their Oil Palm counterparts — just applied under the $ws wildcard.
      "ws": {
        "$ws": {
          "app_state": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('ffbBudget').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('planting').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('gangs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('performance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('rainfall').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "spraying_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "manuring_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "maintenance_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('maintenance').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "ironhorse_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('ironhorse').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "wages_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "wages_ledger_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "wages_daily_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('wages').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "tree_logs_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('treelogs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "tree_logs_invoice_files": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('treelogs').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "weekly_activity_data": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('weekly').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "weekly_images": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('weekly').val() === true || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          },
          "audit_log": {
            "$entryId": {
              ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && data.child('ts').val() < (now - 31536000000)) || root.child('user_roles').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.hasChildren(['ts','user','action']) || !newData.exists()"
            }
          },
          "backup_settings": {
            ".write": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('editableMenus').val() === 'all' || root.child('user_roles').child(auth.uid).child('editableMenusMap').child('dataManagement').val() === true)"
          }
        }
      }
    }
  }
}
